---
import { clinica } from '../data/clinica';
import Icon from './Icon.astro';
---

<header class="sticky top-0 z-40 bg-surface/98 px-margin-sm md:px-margin-lg py-3 border-b border-outline-variant/20 transition-shadow">
  <div class="max-w-7xl mx-auto flex items-center justify-between">
    <!-- Brand / Logo -->
    <a href="#hero" class="flex items-center gap-2.5 group">
      <div class="w-10 h-10 rounded-xl bg-secondary-container flex items-center justify-center text-primary-container shadow-sm group-hover:scale-105 transition-transform">
        <Icon name="dentistry" size={24} />
      </div>
      <div class="flex flex-col">
        <span class="font-headline-sm text-sm tracking-tight text-primary leading-tight font-bold">
          {clinica.doctora.split(' ')[0]} {clinica.doctora.split(' ')[1]} {clinica.doctora.split(' ')[2]}
        </span>
        <span class="font-label-sm text-[11px] text-secondary tracking-wide uppercase">
          {clinica.nombreCorto}
        </span>
      </div>
    </a>

    <!-- Desktop Navigation -->
    <nav class="hidden lg:flex items-center gap-6" aria-label="Navegación principal">
      <a href="#servicios" class="font-label-md text-sm text-on-surface-variant hover:text-primary transition-colors">Servicios</a>
      <a href="#doctora" class="font-label-md text-sm text-on-surface-variant hover:text-primary transition-colors">La Doctora</a>
      <a href="#pasos-cita" class="font-label-md text-sm text-on-surface-variant hover:text-primary transition-colors">Cómo Funciona</a>
      <a href="#opiniones" class="font-label-md text-sm text-on-surface-variant hover:text-primary transition-colors">Opiniones</a>
      <a href="#faq" class="font-label-md text-sm text-on-surface-variant hover:text-primary transition-colors">Preguntas</a>
      <a href="#ubicacion" class="font-label-md text-sm text-on-surface-variant hover:text-primary transition-colors">Ubicación y Horario</a>
    </nav>

    <!-- Header Actions (Dynamic status badge & CTAs) -->
    <div class="flex items-center gap-2.5">
      <!-- Indicador dinámico de horario (desktop) -->
      <div id="estado-horario-badge" class="hidden sm:inline-flex items-center gap-2 px-3 py-1.5 rounded-full bg-secondary-container/60 border border-primary/10 text-xs font-label-md text-primary">
        <span id="estado-horario-dot" class="w-2 h-2 rounded-full bg-[#2A7E64] animate-pulse"></span>
        <span id="estado-horario-texto">Calculando horario...</span>
      </div>

      <!-- Botón Cita -->
      <a
        href="#formulario-cita"
        class="hidden sm:inline-flex items-center justify-center gap-1.5 h-10 px-4 rounded-lg bg-primary-container text-on-primary font-label-md text-xs shadow-sm hover:bg-[#123C47] active:scale-95 transition-all"
      >
        <Icon name="calendar_month" size={16} />
        Pedir Cita
      </a>

      <!-- Botón WhatsApp directo -->
      <a
        href={`https://wa.me/${clinica.whatsappNumeroLimpio}?text=Hola%20Dra.%20Bianca,%20quisiera%20consultar%20por%20una%20cita%20dental`}
        target="_blank"
        rel="noopener noreferrer"
        aria-label="Contactar por WhatsApp"
        class="hidden md:inline-flex items-center justify-center w-10 h-10 rounded-lg bg-[#25D366]/15 text-[#0f532b] hover:bg-[#25D366]/25 active:scale-90 transition-all"
      >
        <Icon name="chat" size={20} />
      </a>

      <!-- Botón menú móvil -->
      <button
        type="button"
        id="menu-toggle-btn"
        aria-label="Abrir menú de navegación"
        aria-expanded="false"
        class="lg:hidden w-10 h-10 rounded-lg bg-surface-container flex items-center justify-center text-primary active:scale-90 transition-transform cursor-pointer"
      >
        <Icon name="menu" size={24} id="menu-icon" />
      </button>
    </div>
  </div>

  <!-- Mobile expandable drawer -->
  <nav
    id="mobile-menu"
    class="hidden flex-col gap-1 pt-3 pb-2 mt-2 bg-surface-container-low rounded-xl px-3 shadow-lg border border-outline-variant/30 lg:hidden"
    aria-label="Menú móvil"
  >
    <a class="menu-link flex items-center gap-3 py-2.5 px-3 rounded-lg text-primary font-label-md text-sm hover:bg-secondary-container/50" href="#hero">
      <Icon name="near_me" size={20} class="text-secondary" />
      Inicio
    </a>
    <a class="menu-link flex items-center gap-3 py-2.5 px-3 rounded-lg text-primary font-label-md text-sm hover:bg-secondary-container/50" href="#servicios">
      <Icon name="dentistry" size={20} class="text-secondary" />
      Servicios
    </a>
    <a class="menu-link flex items-center gap-3 py-2.5 px-3 rounded-lg text-primary font-label-md text-sm hover:bg-secondary-container/50" href="#doctora">
      <Icon name="badge" size={20} class="text-secondary" />
      La Doctora
    </a>
    <a class="menu-link flex items-center gap-3 py-2.5 px-3 rounded-lg text-primary font-label-md text-sm hover:bg-secondary-container/50" href="#pasos-cita">
      <Icon name="check_circle" size={20} class="text-secondary" />
      Cómo Funciona
    </a>
    <a class="menu-link flex items-center gap-3 py-2.5 px-3 rounded-lg text-primary font-label-md text-sm hover:bg-secondary-container/50" href="#opiniones">
      <Icon name="rate_review" size={20} class="text-secondary" />
      Opiniones
    </a>
    <a class="menu-link flex items-center gap-3 py-2.5 px-3 rounded-lg text-primary font-label-md text-sm hover:bg-secondary-container/50" href="#faq">
      <Icon name="contact_support" size={20} class="text-secondary" />
      Preguntas Frecuentes
    </a>
    <a class="menu-link flex items-center gap-3 py-2.5 px-3 rounded-lg text-primary font-label-md text-sm hover:bg-secondary-container/50" href="#ubicacion">
      <Icon name="location_on" size={20} class="text-secondary" />
      Ubicación y Horarios
    </a>
    <div class="pt-2 pb-1 flex flex-col gap-2">
      <a class="menu-link flex items-center justify-center gap-2 w-full h-11 rounded-lg bg-primary-container text-on-primary font-label-md text-sm shadow-sm active:scale-95 transition-transform" href="#formulario-cita">
        <Icon name="calendar_month" size={18} />
        Agendar Cita en Línea
      </a>
    </div>
  </nav>
</header>
