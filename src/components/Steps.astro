---
import { clinica } from '../data/clinica';
import Icon from './Icon.astro';
---

<section id="pasos-cita" class="px-margin-sm md:px-margin-lg py-8 md:py-16 max-w-7xl mx-auto w-full">
  <div class="bg-secondary-container/50 rounded-3xl p-6 md:p-10 border border-outline-variant/30 flex flex-col gap-6">
    <div class="text-center flex flex-col gap-1.5 max-w-xl mx-auto">
      <span class="font-label-sm uppercase tracking-wider text-secondary font-semibold text-xs">
        Paso a paso
      </span>
      <h2 class="font-headline-lg text-2xl md:text-3xl font-bold text-primary">
        ¿Cómo solicitar tu cita?
      </h2>
      <p class="font-body-sm text-xs md:text-sm text-on-surface-variant">
        En solo tres sencillos pasos tendrás tu espacio reservado sin complicaciones.
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-3 md:gap-4">
      {clinica.pasosCita.map((paso) => (
        <div class="bg-surface-container-lowest p-4 md:p-5 rounded-2xl shadow-clinical border-clinical flex items-start gap-3.5 transition-transform hover:-translate-y-0.5">
          <div class="w-9 h-9 rounded-full bg-primary-container text-on-primary flex items-center justify-center font-headline-sm text-xs font-bold shrink-0">
            {paso.numero}
          </div>
          <div class="flex flex-col">
            <h3 class="font-title-md text-sm md:text-base font-bold text-primary">
              {paso.titulo}
            </h3>
            <p class="font-body-sm text-xs md:text-sm text-on-surface-variant leading-relaxed pt-0.5">
              {paso.descripcion}
            </p>
          </div>
        </div>
      ))}
    </div>

    <div class="flex justify-center pt-2">
      <a
        href="#formulario-cita"
        class="flex items-center justify-center gap-2 w-full sm:w-auto px-8 h-12 rounded-xl bg-primary-container text-on-primary font-label-md text-sm font-semibold shadow-md hover:bg-[#123C47] active:scale-95 transition-all"
      >
        <Icon name="check_circle" size={18} />
        <span>Completar formulario de cita</span>
      </a>
    </div>
  </div>
</section>
