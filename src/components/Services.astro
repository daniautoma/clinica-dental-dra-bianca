---
import { servicesData } from '../data/mockData.js';
import Icon from './Icon.astro';
---

<section id="servicios" class="px-margin-sm md:px-margin-lg py-12 md:py-20 max-w-7xl mx-auto w-full flex flex-col gap-10">
  <!-- Section Header -->
  <div class="flex flex-col gap-2 max-w-2xl">
    <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-semibold uppercase tracking-wider bg-teal-50 text-teal-700 border border-teal-200/60 w-fit">
      Atención Personalizada
    </span>
    <h2 class="font-headline-lg text-2xl md:text-4xl font-extrabold text-primary leading-tight tracking-tight">
      Tratamientos Clínicos & Estética Dental
    </h2>
    <p class="font-body-md text-sm md:text-base text-on-surface-variant leading-relaxed">
      Procedimientos odontológicos con tecnología actualizada, materiales biocompatibles y máximo confort por la Dra. Bianca.
    </p>
  </div>

  <!-- Cards Grid (1 col mobile, 3 col desktop como se solicitó) -->
  <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
    {servicesData.map((servicio) => (
      <article class="group bg-white rounded-2xl shadow-sm hover:shadow-xl hover:-translate-y-2 transition-all duration-300 ease-in-out border border-slate-100 overflow-hidden flex flex-col justify-between">
        <div>
          <!-- Contenedor de Imagen con efecto zoom hover -->
          <div class="relative h-56 w-full overflow-hidden bg-slate-100">
            <img
              src={servicio.image}
              alt={servicio.title}
              loading="lazy"
              class="w-full h-full object-cover transition-transform duration-500 ease-out group-hover:scale-110"
            />
            <div class="absolute inset-0 bg-gradient-to-t from-slate-950/40 via-transparent to-transparent pointer-events-none"></div>

            {servicio.badge && (
              <span class="absolute top-4 right-4 bg-white/95 backdrop-blur-sm text-teal-800 text-xs font-semibold px-3 py-1 rounded-full shadow-sm">
                {servicio.badge}
              </span>
            )}

            <div class="absolute bottom-4 left-4 w-11 h-11 rounded-xl bg-white/95 backdrop-blur-md shadow-md flex items-center justify-center text-xl">
              {servicio.icon}
            </div>
          </div>

          <!-- Contenido textual -->
          <div class="p-6">
            <div class="flex items-center justify-between text-xs text-slate-500 mb-2 font-medium">
              <span>Duración aprox:</span>
              <span class="text-teal-700 font-semibold">{servicio.duration}</span>
            </div>
            <h3 class="text-xl font-bold text-slate-800 group-hover:text-teal-700 transition-colors duration-200">
              {servicio.title}
            </h3>
            <p class="mt-2.5 text-sm leading-relaxed text-slate-600">
              {servicio.description}
            </p>
          </div>
        </div>

        <!-- Botón de acción integrado con el flujo de citas -->
        <div class="px-6 pb-6 pt-2">
          <button
            type="button"
            data-servicio-id={servicio.id}
            class="inline-flex items-center justify-center w-full px-4 py-2.5 rounded-xl text-sm font-semibold text-teal-700 bg-teal-50 group-hover:bg-teal-600 group-hover:text-white transition-colors duration-200 gap-2 cursor-pointer"
          >
            <span>Pedir cita para este servicio</span>
            <Icon name="arrow_forward" size={16} class="transition-transform group-hover:translate-x-1" />
          </button>
        </div>
      </article>
    ))}
  </div>

  <!-- Nota aclaratoria médica -->
  <p class="font-body-sm text-xs text-slate-500 text-center italic px-2 pt-2">
    * Todos los procedimientos inician con una valoración clínica diagnóstica previa para determinar el plan de tratamiento idóneo.
  </p>
</section>
