---
import { clinica } from '../data/clinica';
import Icon from './Icon.astro';
---

<section id="servicios" class="px-margin-sm md:px-margin-lg py-8 md:py-16 max-w-7xl mx-auto w-full flex flex-col gap-6">
  <!-- Section Header -->
  <div class="flex flex-col gap-1.5 max-w-2xl">
    <span class="font-label-sm uppercase tracking-wider text-secondary font-semibold text-xs">
      Nuestros Servicios
    </span>
    <h2 class="font-headline-lg text-2xl md:text-3xl font-bold text-primary leading-tight">
      Cuida tu sonrisa en cada etapa
    </h2>
    <p class="font-body-md text-sm md:text-base text-on-surface-variant">
      Procedimientos odontológicos con tecnología actualizada, materiales biocompatibles y máximo confort.
    </p>
  </div>

  <!-- Cards Grid (1 col mobile, 2 col tablet, 4 col desktop) -->
  <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-3.5 md:gap-4">
    {clinica.servicios.map((servicio) => (
      <div class="bg-surface-container-lowest p-5 rounded-2xl shadow-clinical border-clinical flex flex-col justify-between gap-3 transition-all duration-200 hover:-translate-y-1 hover:shadow-md">
        <div class="flex flex-col gap-2.5">
          <div class="flex items-center gap-3">
            <div class="w-11 h-11 rounded-xl bg-secondary-container flex items-center justify-center text-primary-container shrink-0">
              <Icon name={servicio.icono} size={22} />
            </div>
            <div class="flex flex-col">
              <h3 class="font-title-md text-base font-bold text-primary leading-tight">
                {servicio.nombre}
              </h3>
              <span class="font-label-sm text-[11px] text-secondary">
                {servicio.etiqueta}
              </span>
            </div>
          </div>
          <p class="font-body-sm text-xs md:text-sm text-on-surface-variant leading-relaxed pt-1">
            {servicio.descripcion}
          </p>
        </div>

        <button
          type="button"
          data-servicio-id={servicio.id}
          class="inline-flex items-center gap-1.5 text-primary-container font-label-md text-xs font-semibold pt-2 self-start hover:text-primary active:translate-x-1 transition-all cursor-pointer group"
        >
          <span>Pedir cita para este servicio</span>
          <Icon name="arrow_forward" size={16} class="group-hover:translate-x-1 transition-transform" />
        </button>
      </div>
    ))}
  </div>

  <!-- Discreta nota aclaratoria médica -->
  <p class="font-body-sm text-xs text-secondary text-center italic px-2 pt-2">
    * Todos los procedimientos inician con una valoración clínica diagnóstica previa para determinar el plan de tratamiento idóneo.
  </p>
</section>
