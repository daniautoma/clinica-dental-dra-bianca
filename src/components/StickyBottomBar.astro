---
import { clinica } from '../data/clinica';
import Icon from './Icon.astro';
const mensajeWhatsappBase = encodeURIComponent(`Hola Dra. Bianca, deseo consultar sobre una cita dental en ${clinica.nombreCorto}.`);
---

<aside aria-label="Acciones Rápidas Móviles" class="md:hidden fixed bottom-0 left-0 right-0 z-50 bg-surface-container-lowest border-t border-outline-variant/30 px-3 py-2.5 flex items-center gap-2.5 shadow-2xl pb-safe">
  <!-- Call CTA -->
  <a
    href={`tel:${clinica.telefonoLlamada}`}
    class="flex-1 h-12 rounded-xl bg-surface-container-high text-primary font-label-md text-xs font-bold flex items-center justify-center gap-1.5 active:scale-95 transition-transform shadow-sm"
  >
    <Icon name="call" size={18} />
    <span>Llamar</span>
  </a>

  <!-- WhatsApp Official High-Contrast CTA -->
  <a
    href={`https://wa.me/${clinica.whatsappNumeroLimpio}?text=${mensajeWhatsappBase}`}
    target="_blank"
    rel="noopener noreferrer"
    class="flex-[1.5] h-12 rounded-xl bg-[#0e6b45] text-white font-label-md text-sm font-bold flex items-center justify-center gap-2 active:scale-95 transition-transform shadow-md"
  >
    <Icon name="chat" size={20} />
    <span>WhatsApp</span>
  </a>
</aside>
