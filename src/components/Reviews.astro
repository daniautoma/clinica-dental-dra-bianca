---
import { clinica } from '../data/clinica';
import Icon from './Icon.astro';
---

<section id="opiniones" class="px-margin-sm md:px-margin-lg py-8 md:py-16 max-w-7xl mx-auto w-full flex flex-col gap-6">
  <div class="flex flex-col sm:flex-row sm:items-end justify-between gap-3">
    <div class="flex flex-col gap-1">
      <span class="font-label-sm uppercase tracking-wider text-secondary font-semibold text-xs">
        Testimonios Reales
      </span>
      <h2 class="font-headline-lg text-2xl md:text-3xl font-bold text-primary leading-tight">
        Lo que dicen nuestros pacientes
      </h2>
    </div>

    <!-- Rating badge -->
    <a
      href={clinica.direccion.googleMapsUrl}
      target="_blank"
      rel="noopener noreferrer"
      class="self-start sm:self-auto inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full bg-secondary-container text-primary font-label-md text-xs hover:bg-secondary-container/80 transition-colors shadow-sm"
    >
      <Icon name="star" size={16} class="text-amber-500" />
      <span class="font-bold">5.0 de valoración</span>
      <span class="text-secondary">· Google Maps</span>
    </a>
  </div>

  <!-- Review Cards Grid -->
  <div class="grid grid-cols-1 md:grid-cols-3 gap-3.5 md:gap-4">
    {clinica.testimonios.map((testimonio) => (
      <div class="bg-surface-container-lowest p-5 rounded-2xl shadow-clinical border-clinical flex flex-col justify-between gap-3 transition-transform hover:-translate-y-0.5">
        <div class="flex flex-col gap-2.5">
          <div class="flex items-center justify-between">
            <div class="flex items-center gap-2.5">
              <div class="w-9 h-9 rounded-full bg-secondary-container flex items-center justify-center text-primary-container font-headline-sm text-xs font-bold">
                {testimonio.iniciales}
              </div>
              <div class="flex flex-col">
                <span class="font-title-md text-sm font-bold text-primary">
                  {testimonio.nombre}
                </span>
                <span class="font-label-sm text-[11px] text-secondary">
                  {testimonio.rol}
                </span>
              </div>
            </div>
            <div class="flex text-amber-500">
              {Array.from({ length: testimonio.puntuacion }).map(() => (
                <Icon name="star" size={15} />
              ))}
            </div>
          </div>
          <p class="font-body-sm text-xs md:text-sm text-on-surface-variant leading-relaxed">
            "{testimonio.texto}"
          </p>
        </div>
      </div>
    ))}
  </div>

  <!-- Google Maps CTA -->
  <div class="flex justify-center pt-2">
    <a
      href={clinica.direccion.googleMapsUrl}
      target="_blank"
      rel="noopener noreferrer"
      class="inline-flex items-center justify-center gap-2 py-3 px-5 rounded-xl bg-surface-container text-primary font-label-md text-xs font-semibold shadow-sm hover:bg-surface-container-high active:scale-95 transition-all"
    >
      <Icon name="rate_review" size={18} class="text-secondary" />
      <span>Ver perfil y reseñas verificadas en Google Maps</span>
      <Icon name="open_in_new" size={14} />
    </a>
  </div>
</section>
