---
import { clinica } from '../data/clinica';
import { testimonials } from '../data/mockData.js';
import Icon from './Icon.astro';
---

<section id="opiniones" class="px-margin-sm md:px-margin-lg py-12 md:py-16 max-w-7xl mx-auto w-full flex flex-col gap-8">
  <div class="flex flex-col sm:flex-row sm:items-end justify-between gap-4">
    <div class="flex flex-col gap-1.5">
      <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-semibold uppercase tracking-wider bg-teal-50 text-teal-700 border border-teal-200/60 w-fit">
        Testimonios Reales
      </span>
      <h2 class="font-headline-lg text-2xl md:text-3xl font-bold text-primary leading-tight">
        La confianza de nuestros pacientes
      </h2>
    </div>

    <!-- Rating badge -->
    <a
      href={clinica.direccion.googleMapsUrl}
      target="_blank"
      rel="noopener noreferrer"
      class="self-start sm:self-auto inline-flex items-center gap-1.5 px-3.5 py-1.5 rounded-full bg-secondary-container text-primary font-label-md text-xs hover:bg-secondary-container/80 transition-colors shadow-sm"
    >
      <Icon name="star" size={16} class="text-amber-500" />
      <span class="font-bold">5.0 de valoración</span>
      <span class="text-secondary">· Google Maps</span>
    </a>
  </div>

  <!-- Review Cards Grid -->
  <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
    {testimonials.map((testimonio) => (
      <div class="bg-white p-6 rounded-2xl shadow-sm border border-slate-100 flex flex-col justify-between gap-4 transition-all duration-300 hover:-translate-y-1 hover:shadow-md">
        <div class="flex flex-col gap-3">
          <div class="flex items-center justify-between">
            <div class="flex items-center gap-3">
              {testimonio.avatar ? (
                <img
                  src={testimonio.avatar}
                  alt={testimonio.name}
                  class="w-11 h-11 rounded-full object-cover ring-2 ring-teal-500/30"
                />
              ) : (
                <div class="w-11 h-11 rounded-full bg-teal-50 text-teal-700 flex items-center justify-center font-bold text-sm">
                  {testimonio.name.charAt(0)}
                </div>
              )}
              <div class="flex flex-col">
                <span class="font-title-md text-sm font-bold text-slate-800">
                  {testimonio.name}
                </span>
                <span class="font-label-sm text-xs text-teal-600 font-medium">
                  {testimonio.role}
                </span>
              </div>
            </div>
            <div class="flex text-amber-400">
              {Array.from({ length: testimonio.rating }).map(() => (
                <Icon name="star" size={16} />
              ))}
            </div>
          </div>
          <p class="font-body-sm text-sm text-slate-600 leading-relaxed italic pt-1">
            "{testimonio.review}"
          </p>
        </div>
      </div>
    ))}
  </div>

  <!-- Google Maps CTA -->
  <div class="flex justify-center pt-2">
    <a
      href={clinica.direccion.googleMapsUrl}
      target="_blank"
      rel="noopener noreferrer"
      class="inline-flex items-center justify-center gap-2 py-3 px-5 rounded-xl bg-surface-container text-primary font-label-md text-xs font-semibold shadow-sm hover:bg-surface-container-high active:scale-95 transition-all"
    >
      <Icon name="rate_review" size={18} class="text-secondary" />
      <span>Ver perfil y reseñas verificadas en Google Maps</span>
      <Icon name="open_in_new" size={14} />
    </a>
  </div>
</section>
