---
import { clinica } from '../data/clinica';
import Icon from './Icon.astro';
---

<section id="doctora" class="px-margin-sm md:px-margin-lg py-8 md:py-16 max-w-7xl mx-auto w-full">
  <div class="bg-surface-container-low rounded-3xl p-6 md:p-10 border border-outline-variant/30 shadow-clinical flex flex-col lg:grid lg:grid-cols-12 gap-8 items-center">
    <!-- Doctor Portrait Card (5 cols desktop, 1 col mobile) -->
    <div class="w-full lg:col-span-5 relative aspect-[4/5] rounded-2xl overflow-hidden shadow-clinical border-clinical bg-surface-container">
      <img
        src="/fotos/dra-bianca-hernandez.webp"
        alt={`Retrato oficial de ${clinica.doctora}`}
        width="480"
        height="600"
        loading="lazy"
        decoding="async"
        class="w-full h-full object-cover transition-transform duration-500 hover:scale-105"
        onerror="this.style.display='none'; this.nextElementSibling.style.display='flex';"
      />

      <!-- Marcador elegante en caso de sustitución pendiente de fotografía -->
      <div class="hidden absolute inset-0 flex-col items-center justify-center bg-gradient-to-br from-surface-container-low to-secondary-container/40 p-6 text-center">
        <div class="w-16 h-16 rounded-2xl bg-surface-container-lowest flex items-center justify-center text-primary-container shadow-md mb-3">
          <Icon name="badge" size={36} />
        </div>
        <span class="font-label-md text-sm text-primary font-bold">{clinica.doctora}</span>
        <span class="font-body-sm text-xs text-secondary mt-1 max-w-xs">
          Fotografía oficial de la doctora. Colocar en:<br />
          <code class="px-2 py-0.5 mt-1 inline-block bg-surface-container-lowest rounded text-[11px] font-mono text-primary-container">
            public/fotos/dra-bianca-hernandez.webp
          </code>
        </span>
      </div>

      <!-- Gradiente inferior y tarjeta flotante con nombre -->
      <div class="absolute inset-0 bg-gradient-to-t from-primary/80 via-transparent to-transparent pointer-events-none"></div>
      <div class="absolute bottom-3.5 left-3.5 right-3.5 bg-surface-container-lowest p-3.5 rounded-xl shadow-md border border-white/40">
        <h3 class="font-title-md text-sm md:text-base font-bold text-primary">
          {clinica.doctora}
        </h3>
        <p class="font-label-sm text-xs text-secondary font-medium">
          {clinica.tituloProfesional}
        </p>
      </div>
    </div>

    <!-- Doctor Bio & Credentials (7 cols desktop) -->
    <div class="w-full lg:col-span-7 flex flex-col gap-4">
      <div class="flex flex-col gap-1">
        <span class="font-label-sm uppercase tracking-wider text-secondary font-semibold text-xs">
          Conoce a tu odontóloga
        </span>
        <h2 class="font-headline-lg text-2xl md:text-3xl font-bold text-primary leading-tight">
          Un espacio para cuidar de tu sonrisa con tranquilidad
        </h2>
      </div>

      <p class="font-body-md text-sm md:text-base text-on-surface-variant leading-relaxed">
        Comprometida con una práctica odontológica donde la empatía, la paciencia y el rigor técnico van de la mano. En cada consulta me aseguro de que comprendas cada detalle de tu diagnóstico y tratamiento en un ambiente moderno y sereno.
      </p>

      <!-- Credentials List -->
      <div class="flex flex-col gap-2.5 pt-2">
        <div class="flex items-center gap-3">
          <div class="w-8 h-8 rounded-lg bg-secondary-container flex items-center justify-center text-primary-container shrink-0">
            <Icon name="verified_user" size={18} />
          </div>
          <span class="font-body-sm text-xs md:text-sm text-on-surface font-medium">
            Registro Profesional Autorizado en El Salvador
          </span>
        </div>
        <div class="flex items-center gap-3">
          <div class="w-8 h-8 rounded-lg bg-secondary-container flex items-center justify-center text-primary-container shrink-0">
            <Icon name="workspace_premium" size={18} />
          </div>
          <span class="font-body-sm text-xs md:text-sm text-on-surface font-medium">
            Actualización Continua en Estética & Restauración Dental
          </span>
        </div>
        <div class="flex items-center gap-3">
          <div class="w-8 h-8 rounded-lg bg-secondary-container flex items-center justify-center text-primary-container shrink-0">
            <Icon name="favorite" size={18} />
          </div>
          <span class="font-body-sm text-xs md:text-sm text-on-surface font-medium">
            Atención sin dolor con enfoque humano y trato sin prisas
          </span>
        </div>
      </div>

      <div class="pt-3">
        <a
          href="#formulario-cita"
          class="inline-flex items-center justify-center gap-2 w-full sm:w-auto px-7 h-12 rounded-xl bg-primary-container text-on-primary font-label-md text-sm shadow-md hover:bg-[#123C47] active:scale-95 transition-all"
        >
          <Icon name="event" size={18} />
          <span>Solicitar una cita con la Dra.</span>
        </a>
      </div>
    </div>
  </div>
</section>
